# Copy to .env (docker compose reads it) or set these in your host's dashboard.

# The public URL people open. Recap links, Slack buttons, and secure cookies (https) come from it.
BASE_URL=https://timeline.example.com

# Required unless BASE_URL is localhost or TIMELINE_DEMO=1. Signs session cookies and, unless
# ENCRYPTION_KEY is set, derives the key that encrypts everyone's API keys at rest.
# Changing it signs everyone out and makes saved API keys unreadable (people re-enter them).
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=

# Optional: an explicit Fernet key for API-key encryption, so SECRET_KEY can rotate on its own.
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=

# Sign in with Google (recommended). Create an OAuth client (type: Web application) at
# console.cloud.google.com → APIs & Services → Credentials, with the redirect URI
# <BASE_URL>/auth/google/callback. Only the openid, email, and profile scopes are used.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only these Google Workspace domains can sign in (comma-separated). Leave empty to allow any Google account.
ALLOWED_EMAIL_DOMAINS=rox.com
# Email/password accounts are off when Google is set up; set to 1 to allow both.
# PASSWORD_LOGIN=0

# The public example page at /preview/ (and what signed-out visitors see first). It runs one
# shared profile on these keys, so its cost is yours: about the same as one person, $20–35/month.
# Leave either empty to turn the example page off.
PREVIEW_TWITTERAPI_IO_KEY=
PREVIEW_AI_GATEWAY_API_KEY=
PREVIEW_PRESET=sf_tech
# PREVIEW_REFRESH_TIMES=08:30,20:00   # the example page refreshes at these times (Pacific), every day

# Daily engagement DM (pipeline/engage.py, people in engage.json): a Slack bot DMs one person
# picks of what each teammate should engage with on X today. Off until the bot token and DM target are set.
# Create the bot with the manifest in README → "Daily engagement DM", install it, copy the Bot User OAuth Token.
ENGAGE_SLACK_BOT_TOKEN=
ENGAGE_DM_EMAIL=
# ENGAGE_DM_USER=            # a Slack member id, instead of looking the email up
# ENGAGE_TIME=11:00          # 24-hour, in ENGAGE_TIMEZONE
# ENGAGE_TIMEZONE=America/Los_Angeles
# ENGAGE_WEEKDAYS_ONLY=0
# Uses the PREVIEW_* keys unless these are set:
# ENGAGE_TWITTERAPI_IO_KEY=
# ENGAGE_AI_GATEWAY_API_KEY=

# Marketing channel digest (pipeline/channel.py): the GTM & marketing archetype's report, condensed,
# plus market intel, posted to a Slack channel. The archetype is a separate profile at /gtm/ that admins
# edit there (Settings). Off until CHANNEL_SLACK_CHANNEL is set. Reuses the engagement bot unless
# CHANNEL_SLACK_BOT_TOKEN is set; invite the bot to the channel (/invite @Engage digest).
CHANNEL_SLACK_CHANNEL=          # channel ID (channel details → bottom), e.g. C0123ABCD; or an email to test it as a DM
# CHANNEL_TIME=09:30            # 24-hour, in CHANNEL_TIMEZONE (defaults to ENGAGE_TIMEZONE)
# CHANNEL_WEEKDAYS_ONLY=1
# CHANNEL_EVENING_REFRESH=20:00 # the GTM report's second daily refresh (the first is just before the post); empty turns it off
# CHANNEL_PRESET=gtm_marketing  # only used when the archetype is first created
# ADMIN_EMAILS=vivek@rox.com    # who can edit /gtm/ and post the digest now (defaults to ENGAGE_DM_EMAIL)
# Market intel from another bot: its page (fetched at post time), and/or a token it can push to /api/intel with.
# For comp-intel (a GitHub Pages site rendered in the browser from data/today.json), read the JSON
# and link the page:
#   INTEL_URL=https://vivekyarla.github.io/comp-intel/data/today.json
#   INTEL_PAGE_URL=https://vivekyarla.github.io/comp-intel/
INTEL_URL=
INTEL_PAGE_URL=                 # the page the post links to, if INTEL_URL is a data file
INTEL_PUSH_TOKEN=               # python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Keys default to ENGAGE_* then PREVIEW_*:
# CHANNEL_TWITTERAPI_IO_KEY=
# CHANNEL_AI_GATEWAY_API_KEY=

# Where the SQLite file and per-user pages live. The Docker image uses /data (mount a volume there).
# DATA_DIR=/data

# Pipeline runs at once across all users, and hours between each user's updates.
MAX_CONCURRENT_RUNS=3
REFRESH_HOURS=3

# 1 = sample data only: no key checks, no API calls, pages built from pipeline/demo_state.json.
TIMELINE_DEMO=0

# Login/signup attempts allowed per IP per 10 minutes.
# RATE_LIMIT=20

# Behind a platform proxy (Fly.io, Railway, Render), let uvicorn read the client IP from
# X-Forwarded-For so the login rate limit is per person, not per proxy. Only set this when
# the app is reachable through the proxy alone.
# FORWARDED_ALLOW_IPS=*
